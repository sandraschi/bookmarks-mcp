  "manifest_prompts": [
    {
      "name": "list_bookmarks_prompt",
      "template": "List bookmarks from {browser} (profile: {profile_name})",
      "maps_to": {
        "tool_call": "browser_bookmarks",
        "parameters": {
          "operation": "list_bookmarks",
          "browser": "{browser}",
          "profile_name": "{profile_name}"
        }
      }
    },
    {
      "name": "search_bookmarks_prompt",
      "template": "Search {browser} bookmarks for: {search_query}",
      "maps_to": {
        "tool_call": "browser_bookmarks",
        "parameters": {
          "operation": "search_bookmarks",
          "browser": "{browser}",
          "search_query": "{search_query}"
        }
      }
    },
    {
      "name": "sync_bookmarks_prompt",
      "template": "Sync bookmarks from {source_browser} to {target_browser}",
      "maps_to": {
        "tool_call": "sync_bookmarks",
        "parameters": {
          "source_browser": "{source_browser}",
          "target_browser": "{target_browser}",
          "dry_run": true
        }
      }
    }
  ],
  "error_handling_examples": [
    {
      "error": "Database is locked",
      "recovery": "Ask user to close Firefox/Chrome, then retry",
      "tool_hint": "browser_bookmarks with force_access=True (Firefox only)"
    },
    {
      "error": "Unknown operation",
      "recovery": "Read available_operations from response and pick valid operation literal"
    },
    {
      "error": "sync_bookmarks requires target_browser",
      "recovery": "Set target_browser parameter explicitly"
    }
  ]
}
