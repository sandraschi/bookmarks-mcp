{
  "examples": [
    {
      "title": "List Chrome bookmarks",
      "user_input": "Show my Chrome bookmarks",
      "tool_call": "browser_bookmarks",
      "parameters": {
        "operation": "list_bookmarks",
        "browser": "chrome",
        "limit": 50,
        "offset": 0
      },
      "expected_output": "success with results, pagination.has_more if library is large"
    },
    {
      "title": "List Firefox bookmarks in profile",
      "user_input": "List bookmarks in Firefox profile dev",
      "tool_call": "browser_bookmarks",
      "parameters": {
        "operation": "list_bookmarks",
        "browser": "firefox",
        "profile_name": "dev",
        "limit": 100
      },
      "expected_output": "success with bookmarks array and pagination metadata"
    },
    {
      "title": "Search Firefox by keyword",
      "user_input": "Search Firefox for rust tutorials",
      "tool_call": "browser_bookmarks",
      "parameters": {
        "operation": "search_bookmarks",
        "browser": "firefox",
        "profile_name": "default",
        "search_query": "rust tutorial"
      },
      "expected_output": "matching bookmarks with total_matches count"
    },
    {
      "title": "Search Edge bookmarks",
