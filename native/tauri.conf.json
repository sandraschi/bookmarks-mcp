{
  "productName": "Bookmarks MCP",
  "version": "0.2.0",
  "identifier": "ai.fleet.bookmarks-mcp",
  "build": {
    "frontendDist": "../web_sota/dist",
    "devUrl": "http://localhost:10802",
    "beforeDevCommand": "npm --prefix ../web_sota run dev",
    "beforeBuildCommand": "pwsh -NoProfile -Command \"$env:VITE_API_URL='http://127.0.0.1:10803'; npm --prefix ../web_sota run build\""
  },
  "app": {
    "windows": [
      {
        "title": "Bookmark Master",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10803 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bookmarks-mcp-backend.exe",
            "resources/.env.example"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
"installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "process": {
      "all": true
    }
  }
}




