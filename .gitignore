# Assfix working snapshots (regenerable; committed copy lives in docs/assess-reports/)
reports/

*.bak*

# MCPB build artifact -- staging copy of src/, regenerated by mcpb/pack.ps1
# on every pack. Never hand-edit, never commit.
mcpb/src/
